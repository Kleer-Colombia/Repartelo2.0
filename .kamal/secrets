# Kamal carga este archivo (vía dotenv) al ejecutar cualquier comando
# `kamal ...`. Ninguna línea de acá tiene el valor real de un secreto: cada
# una toma el valor de una variable con el mismo nombre ya exportada en el
# shell del operador. Se puede commitear tranquilo — lo que hay que cuidar
# es no exportar estas variables en un lugar trackeado por git (ver
# docs/MIGRACION_HETZNER.md, sección de deploy con Kamal, para cómo
# cargarlas antes de correr kamal).

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SECRET_KEY_BASE=$SECRET_KEY_BASE
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# Compuesta a partir de POSTGRES_PASSWORD de arriba. "repartelo-postgres" es
# el nombre que Kamal le pone al contenedor del accessory (service-name),
# resoluble por DNS interna de Docker desde el contenedor de la app.
DATABASE_URL=postgres://repartelo:${POSTGRES_PASSWORD}@repartelo-postgres:5432/repartelo_production

DRIVE_CONTABILIDAD_FOLDER_ID=$DRIVE_CONTABILIDAD_FOLDER_ID
ALEGRA_EMAIL=$ALEGRA_EMAIL
ALEGRA_TOKEN=$ALEGRA_TOKEN

SMTP_ADDRESS=$SMTP_ADDRESS
SMTP_PORT=$SMTP_PORT
SMTP_DOMAIN=$SMTP_DOMAIN
SMTP_USERNAME=$SMTP_USERNAME
SMTP_PASSWORD=$SMTP_PASSWORD
SMTP_AUTH=$SMTP_AUTH
SMTP_ENABLE_STARTTLS_AUTO=$SMTP_ENABLE_STARTTLS_AUTO
ACTION_MAILER_HOST=$ACTION_MAILER_HOST
ACTION_MAILER_DEFAULT_FROM=$ACTION_MAILER_DEFAULT_FROM
ACTION_MAILER_DEFAULT_TO=$ACTION_MAILER_DEFAULT_TO
