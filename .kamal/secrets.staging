# Secretos de STAGING (kamal ... -d staging). Igual que .kamal/secrets: no
# hay valores reales acá, cada línea toma una variable del shell del
# operador (ver .env.kamal). Staging usa SECRET_KEY_BASE y contraseña de
# Postgres propias, distintas de producción.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SECRET_KEY_BASE=$STAGING_SECRET_KEY_BASE
POSTGRES_PASSWORD=$STAGING_POSTGRES_PASSWORD

# "repartelo-staging-postgres" = accessories.postgres.service en config/deploy.staging.yml
DATABASE_URL=postgres://repartelo:${STAGING_POSTGRES_PASSWORD}@repartelo-staging-postgres:5432/repartelo_staging

# Mismos valores que producción por ahora (Alegra de pruebas si existe).
DRIVE_CONTABILIDAD_FOLDER_ID=$DRIVE_CONTABILIDAD_FOLDER_ID
ALEGRA_EMAIL=$ALEGRA_EMAIL
ALEGRA_TOKEN=$ALEGRA_TOKEN

SMTP_ADDRESS=$SMTP_ADDRESS
SMTP_PORT=$SMTP_PORT
SMTP_DOMAIN=$SMTP_DOMAIN
SMTP_USERNAME=$SMTP_USERNAME
SMTP_PASSWORD=$SMTP_PASSWORD
SMTP_AUTH=$SMTP_AUTH
SMTP_ENABLE_STARTTLS_AUTO=$SMTP_ENABLE_STARTTLS_AUTO
ACTION_MAILER_HOST=$ACTION_MAILER_HOST
ACTION_MAILER_DEFAULT_FROM=$ACTION_MAILER_DEFAULT_FROM
ACTION_MAILER_DEFAULT_TO=$ACTION_MAILER_DEFAULT_TO
