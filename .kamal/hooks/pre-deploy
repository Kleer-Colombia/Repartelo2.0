#!/bin/sh
# Regla del proyecto: a producción solo llega una versión que ya está
# corriendo (y fue probada) en staging. Ver CLAUDE.md y
# docs/MIGRACION_HETZNER.md, sección "Promoción staging -> producción".
#
# Kamal corre este hook antes de cada deploy, con estas variables:
#   KAMAL_DESTINATION  vacío en producción, "staging" en staging
#   KAMAL_VERSION      versión (tag de imagen) que se va a desplegar
#   KAMAL_SERVICE      "repartelo"
#   KAMAL_HOSTS        hosts separados por coma
#
# Emergencia (saltear la verificación, queda registrado en la salida):
#   pasar -e KAMAL_ALLOW_PROD_WITHOUT_STAGING=1 al docker run de kamal.

set -eu

# Deploys a staging (u otro destino): sin restricción.
if [ -n "${KAMAL_DESTINATION:-}" ]; then
  exit 0
fi

# Rollback: vuelve a una versión que ya estuvo en producción (y por lo tanto
# ya pasó por staging). No bloquearlo: es la salida de emergencia.
if [ "${KAMAL_COMMAND:-}" = "rollback" ]; then
  echo "↩️  Rollback de producción a $KAMAL_VERSION: sin verificación de staging."
  exit 0
fi

if [ "${KAMAL_ALLOW_PROD_WITHOUT_STAGING:-}" = "1" ]; then
  echo "⚠️  KAMAL_ALLOW_PROD_WITHOUT_STAGING=1: deploy a PRODUCCIÓN sin verificar staging."
  exit 0
fi

ssh_user="${KAMAL_SSH_USER:-root}"
missing=""

for host in $(echo "$KAMAL_HOSTS" | tr ',' ' '); do
  images=$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$ssh_user@$host" \
    "docker ps --filter label=service=$KAMAL_SERVICE --filter label=destination=staging --filter label=role=web --format '{{.Image}}'") || {
    echo "❌ No pude consultar staging en $host (SSH/docker). Deploy a producción cancelado."
    exit 1
  }
  if ! echo "$images" | grep -q ":$KAMAL_VERSION\$"; then
    missing="$missing $host"
    echo "   En $host staging corre: ${images:-(nada)}"
  fi
done

if [ -n "$missing" ]; then
  echo "❌ La versión $KAMAL_VERSION no está corriendo en staging (host:$missing)."
  echo "   Orden obligatorio: kamal deploy -d staging -> pruebas -> OK ->"
  echo "   kamal deploy --skip-push --version <versión de staging>"
  echo "   (la versión sale de: kamal app version -d staging)"
  exit 1
fi

echo "✅ $KAMAL_VERSION ya corre en staging. Sigue el deploy a producción."
